# Royal Metal Allocation System — environment configuration
# Copy to .env and fill in real values. Never commit .env.

APP_NAME="Royal Metal Allocation System"
APP_VERSION="1.0.0-py"

DATABASE_URL="postgresql+psycopg://rmas:rmas@localhost:5432/rmas"

APP_TIMEZONE="Asia/Kolkata"

# Google OAuth / Workspace SSO — the frontend authenticates with Google and
# sends the resulting ID token as a Bearer token; the backend verifies it
# against this client id.
GOOGLE_OAUTH_CLIENT_ID=""
# Optional: restrict sign-in to one Workspace domain, e.g. "royalchains.com".
# Leave blank to accept any verified Google identity.
GOOGLE_WORKSPACE_HOSTED_DOMAIN=""

SAVE_LOCK_TIMEOUT_SECONDS=30.0
REQUEST_ID_TTL_SECONDS=900

WEIGHT_DECIMALS=3
WEIGHT_EPSILON=0.0005
MAX_WEIGHT_KG=100000
